rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == '3drprintstore@gmail.com'
        && request.auth.token.email_verified == true;
    }

    function validOrderItem(item) {
      return item is map
        && item.keys().hasAll(['productId', 'quantity'])
        && item.keys().hasOnly(['productId', 'variantId', 'quantity'])
        && item.productId is string
        && item.productId.matches('^[A-Za-z0-9_-]{1,150}$')
        && item.quantity is int
        && item.quantity >= 1
        && item.quantity <= 99
        && (!('variantId' in item) || (item.variantId is string && item.variantId.matches('^[A-Za-z0-9_-]{1,150}$')))
        && get(/databases/$(database)/documents/products/$(item.productId)).data.published == true;
    }

    function validOrderItems(items) {
      return items is list
        && items.size() > 0
        && items.size() <= 10
        && validOrderItem(items[0])
        && (items.size() < 2 || validOrderItem(items[1]))
        && (items.size() < 3 || validOrderItem(items[2]))
        && (items.size() < 4 || validOrderItem(items[3]))
        && (items.size() < 5 || validOrderItem(items[4]))
        && (items.size() < 6 || validOrderItem(items[5]))
        && (items.size() < 7 || validOrderItem(items[6]))
        && (items.size() < 8 || validOrderItem(items[7]))
        && (items.size() < 9 || validOrderItem(items[8]))
        && (items.size() < 10 || validOrderItem(items[9]));
    }

    match /siteContent/{documentId} {
      allow read: if true;
      allow create, update: if isAdmin();
      allow delete: if false;
    }

    match /products/{productId} {
      allow read: if resource.data.published == true || isAdmin();
      allow create, update, delete: if isAdmin();
    }

    match /productColors/{colorId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /orders/{orderId} {
      allow create: if request.resource.data.keys().hasOnly(['items', 'status', 'createdAt'])
        && request.resource.data.keys().hasAll(['items', 'status', 'createdAt'])
        && validOrderItems(request.resource.data.items)
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt == request.time;
      allow read, delete: if isAdmin();
      allow update: if isAdmin()
        && resource.data.status in ['pending', 'confirmed']
        && request.resource.data.status in ['confirmed', 'cancelled']
        && request.resource.data.items == resource.data.items
        && request.resource.data.createdAt == resource.data.createdAt
        && (resource.data.status == 'pending'
          || (resource.data.status == 'confirmed' && request.resource.data.status == 'cancelled'));
    }

    match /inquiries/{inquiryId} {
      allow create: if request.resource.data.keys().hasAll([
          'name', 'email', 'category', 'details', 'createdAt', 'status'
        ])
        && request.resource.data.keys().hasOnly([
          'name', 'email', 'category', 'details', 'createdAt', 'status'
        ])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 120
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 254
        && request.resource.data.email.matches('^[^@ ]+@[^@ ]+\\.[^@ ]+$')
        && request.resource.data.category is string
        && request.resource.data.category.size() <= 80
        && request.resource.data.details is string
        && request.resource.data.details.size() >= 2
        && request.resource.data.details.size() <= 5000
        && request.resource.data.status == 'new'
        && request.resource.data.createdAt == request.time;
      allow read, update, delete: if isAdmin();
    }
  }
}

